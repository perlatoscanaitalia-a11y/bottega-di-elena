---
import { languages, languageNames, languageTags, type Language } from '../data/menu-digitale/lingue';
interface Props { current?: Language; label?: string; large?: boolean; }
const {current, label = 'Scegli la lingua / Choose your language', large = false} = Astro.props;
---
<nav class:list={['languages', { 'languages-large': large }]} aria-label={label}>
  {languages.map(lang => <a href={`/menu/${lang}/`} data-menu-language={lang} lang={languageTags[lang]} hreflang={languageTags[lang]} aria-label={languageNames[lang]} aria-current={current === lang ? 'page' : undefined}>
    <svg class="flag" viewBox="0 0 30 20" aria-hidden="true">
      {lang==='it' && <><path fill="#fff" d="M0 0h30v20H0z"/><path fill="#009246" d="M0 0h10v20H0z"/><path fill="#ce2b37" d="M20 0h10v20H20z"/></>}
      {lang==='fr' && <><path fill="#fff" d="M0 0h30v20H0z"/><path fill="#002395" d="M0 0h10v20H0z"/><path fill="#ed2939" d="M20 0h10v20H20z"/></>}
      {lang==='de' && <><path fill="#ffce00" d="M0 0h30v20H0z"/><path fill="#d00" d="M0 0h30v13.33H0z"/><path fill="#000" d="M0 0h30v6.67H0z"/></>}
      {lang==='en' && <><path fill="#012169" d="M0 0h30v20H0z"/><path stroke="#fff" stroke-width="5" d="m0 0 30 20M30 0 0 20"/><path stroke="#c8102e" stroke-width="2" d="m0 0 30 20M30 0 0 20"/><path stroke="#fff" stroke-width="7" d="M15 0v20M0 10h30"/><path stroke="#c8102e" stroke-width="4" d="M15 0v20M0 10h30"/></>}
      {lang==='es' && <><path fill="#aa151b" d="M0 0h30v20H0z"/><path fill="#f1bf00" d="M0 5h30v10H0z"/></>}
      {lang==='zh' && <><path fill="#de2910" d="M0 0h30v20H0z"/><path fill="#ffde00" d="m6 3 1 3h3L7.5 8 8.5 11 6 9 3.5 11 4.5 8 2 6h3z"/><circle fill="#ffde00" cx="12" cy="3" r="1"/><circle fill="#ffde00" cx="14" cy="6" r="1"/><circle fill="#ffde00" cx="14" cy="10" r="1"/><circle fill="#ffde00" cx="12" cy="13" r="1"/></>}
      {lang==='ja' && <><path fill="#fff" d="M0 0h30v20H0z"/><circle fill="#bc002d" cx="15" cy="10" r="6"/></>}
    </svg><span>{languageNames[lang]}</span>
  </a>)}
</nav>
