---
import { site } from '../data/site';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="PANIFICIO ELENA – Bottega dei Sapori Toscani, home">
      <span class="brand-mark">E</span><span><strong>PANIFICIO ELENA</strong><small>Bottega dei Sapori Toscani · Firenze</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Navigazione principale">
      <div class="nav-links">
        {site.nav.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
      </div>
    </nav>
    <nav class="mobile-nav" aria-label="Navigazione principale">
      <details class="nav-menu">
        <summary>Menu</summary>
        <div class="nav-links">
          {site.nav.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
        </div>
      </details>
    </nav>
    <a class="button button-small desktop-call" href={site.phoneHref}>Chiama</a>
  </div>
</header>

<style>
  .desktop-nav{display:none}
  @media(min-width:980px){.desktop-nav{display:block}.mobile-nav{display:none}}
</style>

