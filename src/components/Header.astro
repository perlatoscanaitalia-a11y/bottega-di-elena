---
import { site } from '../data/site';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="ELENA – Bottega dei Sapori Toscani, home">
      <span class="brand-mark">E</span><span><strong>ELENA</strong><small>Bottega dei Sapori Toscani · Firenze</small></span>
    </a>
    <nav aria-label="Navigazione principale">
      <details class="nav-menu">
        <summary>Menu</summary>
        <div class="nav-links">
          {site.nav.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>)}
        </div>
      </details>
    </nav>
    <a class="button button-small desktop-call" href={site.phoneHref}>Chiama</a>
  </div>
</header>

