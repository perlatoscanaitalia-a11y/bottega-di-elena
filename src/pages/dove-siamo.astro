---
import BaseLayout from '../layouts/BaseLayout.astro'; import Hero from '../components/Hero.astro'; import { site } from '../data/site';
---
<BaseLayout title="Dove siamo e orari | ELENA – Bottega dei Sapori Toscani Firenze" description="Trova ELENA – Bottega dei Sapori Toscani in Via Masaccio 16 R/B, altezza civico 184, Firenze. Consulta telefono e orari da settembre.">
  <Hero compact eyebrow="Dove siamo" title="In Via Masaccio, a Firenze." text="Siamo una bottega di quartiere nella zona di Campo di Marte. Il nostro ingresso è al 16 R/B, all’altezza del civico 184." />
  <section class="section shell contact-grid"><div><p class="eyebrow">Indirizzo e contatti</p><h2>{site.address.street}</h2><p>{site.address.postalCode} {site.address.city} ({site.address.region})<br /><strong>{site.address.note}</strong></p><p class="contact-actions"><a class="button" href={site.phoneHref}>Chiama {site.phone}</a><a class="text-link" href={site.emailHref}>{site.email}</a></p></div><div class="hours-card"><h2>Orari da settembre</h2>{site.hours.map((h) => <p class="hours"><span>{h.label}</span><strong>{h.display}</strong></p>)}</div></section>
  <section class="shell section"><p class="eyebrow">Mappa</p><div class="map-embed"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d92189.10039346885!2d11.216944301559602!3d43.774739750693584!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x132a546d62640001%3A0xa4e9926dea567dd8!2sELENA%20%E2%80%93%20Bottega%20dei%20Sapori%20Toscani!5e0!3m2!1sen!2sit!4v1786731518207!5m2!1sen!2sit" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
  <section class="faq shell section"><p class="eyebrow">Indicazioni utili</p><h2>Prima di venire</h2><details><summary>Qual è il civico corretto?</summary><p>L’indirizzo è Via Masaccio 16 R/B. Come riferimento, il negozio si trova all’altezza del civico 184.</p></details><details><summary>La disponibilità dei prodotti è sempre la stessa?</summary><p>No. Pane, prodotti freschi, frutta e verdura possono variare. Per una richiesta specifica, chiamaci.</p></details></section>
</BaseLayout>

