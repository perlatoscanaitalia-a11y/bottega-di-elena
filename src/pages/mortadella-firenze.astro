---
import BaseLayout from '../layouts/BaseLayout.astro';
import MortadellaProduct from '../components/MortadellaProduct.astro';
import { mortadellaProducts } from '../data/mortadella';
import { site } from '../data/site';
import '../styles/mortadella.css';
const loyaltyWhatsapp = 'https://wa.me/393270034324?text=Buongiorno%2C%20vorrei%20richiedere%20la%20Tessera%20Fedelt%C3%A0%20ELENA';
const sources = {
  product: 'https://palmierisalumi.it/prodotto/mortadella-favola-gran-riserva/',
  awards2023: 'https://palmierisalumi.it/mortadella-favola-gran-riserva-e-la-migliore-mortadella-ditalia/',
  awards2025: 'https://it.linkedin.com/posts/salumificio-mec-palmieri-s.p.a._siamo-entusiasti-di-annunciare-che-la-nostra-activity-7257346139144830976-UOmM',
  production: 'https://palmierisalumi.it/2025/wp-content/uploads/2025/09/BILANCIO-PALMIERI_REV-5-singole-sito-ok.pdf',
  luxury: 'https://palmierisalumi.it/favola-gran-riserva-premiata-ai-luxury-food-beverage-quality-awards-come-miglior-mortadella/',
};
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Mortadella a Firenze', url: `${site.url}/mortadella-firenze/`, inLanguage: ['it', 'en'], mainEntity: { '@type': 'ItemList', itemListElement: mortadellaProducts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name, url: `${site.url}/mortadella-firenze/#${p.id}` })) } };
---
<BaseLayout title="Mortadella Firenze: Favola Gran Riserva e schiacciate | ELENA" description="Scopri la mortadella a Firenze da ELENA: Favola Gran Riserva premiata, mortadella al tartufo e schiacciate toscane. Chiedi il ritiro in Via Masaccio." path="/mortadella-firenze/" image="/images/favola-gran-riserva-palmieri.webp" imageAlt="Mortadella Favola Gran Riserva Palmieri" structuredData={schema}>
  <div class="shell breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/salumi-e-formaggi/">Il banco</a><span aria-hidden="true">/</span><span>Mortadella</span></div>
  <section class="shell mort-hero">
    <div><p class="eyebrow">ELENA · Bottega dei Sapori Toscani · Firenze</p><h1>La Migliore Mortadella d'Italia a Firenze</h1><p class="lead">Scopri la pluripremiata Mortadella Favola Gran Riserva, la Mortadella al Tartufo e le nostre schiacciate toscane.</p><p lang="en" class="mort-english lead">Award-Winning Italian Mortadella in Florence.</p><a class="button" href="#scegli">Scegli il tuo gusto <span aria-hidden="true">↓</span></a><p class="mort-caption">Al banco, nella schiacciata, da portare con te.</p><a class="mort-loyalty-teaser" href="#tessera-fedelta"><strong>Tessera Fedeltà ELENA 💚</strong><span>Risparmia fino al 44% sui prodotti selezionati.</span><span lang="en">Save up to 44% on selected products.</span><span class="text-link">Scopri i vantaggi / Discover the benefits ↓</span></a></div>
    <figure><img src="/images/favola-gran-riserva-palmieri.webp" alt="La Mortadella Favola Gran Riserva Palmieri scelta per il banco di ELENA a Firenze" width="800" height="800" fetchpriority="high" /><figcaption>Cinque Spilli · Guida Salumi d’Italia 2025</figcaption></figure>
  </section>
  <section class="mort-awards"><div class="shell"><p class="eyebrow">Favola Gran Riserva · Mec Palmieri</p><h2>Una storia di gusto. Riconosciuta.</h2><div class="mort-award-grid"><div><strong>2023</strong><p>Migliore Mortadella d’Italia, Cinque Spilli e Top 11 della Guida Salumi d’Italia.</p><a href={sources.awards2023}>Il riconoscimento 2023 ↗</a></div><div><strong>2025</strong><p>Cinque Spilli, Migliore Mortadella d’Italia e Miglior Salume d’Italia, secondo la comunicazione ufficiale Palmieri sulla Guida 2025.</p><a href={sources.awards2025}>La comunicazione Palmieri ↗</a></div><div><strong>Luxury 2025</strong><p>Luxury Food &amp; Beverage Quality Award nella categoria mortadella.</p><a href={sources.luxury}>Il premio e la sua attribuzione ↗</a></div></div><p class="mort-craft">Carne selezionata, miele e Sale Dolce di Cervia: tre ingredienti caratteristici della Favola Gran Riserva. Palmieri documenta per la Gran Riserva la legatura manuale, l’insacco nella cotenna e la cottura lenta nei forni in pietra. La sezione «Favola: l’Originale e Gran Riserva» del bilancio Palmieri indica una durata di circa 20 ore.</p><p><a href={sources.product}>Scheda ufficiale Gran Riserva</a> · <a href={sources.production}>Lavorazione Originale e Gran Riserva: bilancio Palmieri, pagina 25 (PDF)</a></p></div></section>
  <section class="section shell" id="scegli" aria-labelledby="banco-title"><p class="eyebrow">Da affettare per te</p><h2 id="banco-title">La mortadella, come piace a te.</h2><p class="lead">Scegli 100 g, 200 g o 300 g e chiedi conferma per il ritiro.</p><div class="mort-bank">{mortadellaProducts.slice(0, 2).map(product => <MortadellaProduct product={product} />)}</div></section>
  <section class="soft"><div class="section shell"><p class="eyebrow">Il pane toscano incontra la mortadella</p><h2>Tre schiacciate. Tre modi di innamorarsi.</h2><p class="lead" lang="en">Discover our Tuscan schiacciata sandwiches: choose your filling and ask us about collection.</p><div class="mort-sandwiches">{mortadellaProducts.slice(2).map(product => <MortadellaProduct product={product} />)}</div><p class="section-link"><a class="text-link" href="/schiacciate-panini-firenze/">Scopri tutte le nostre schiacciate →</a></p></div></section>
  <section class="shell mort-loyalty-section" id="tessera-fedelta" aria-labelledby="tessera-title">
    <div class="mort-loyalty-panel"><div><p class="eyebrow">Tessera Fedeltà ELENA</p><h2 id="tessera-title">Risparmia fino al <span class="mort-loyalty-saving">44%</span></h2><p class="lead"><strong>Sui prodotti selezionati con la Tessera Fedeltà ELENA.</strong></p><p>Richiedila su WhatsApp e scopri le offerte riservate ai clienti della nostra bottega.</p><p class="mort-loyalty-terms"><em>Sconti e condizioni variano in base al prodotto. Promozioni valide in negozio secondo le condizioni applicabili.</em></p><div lang="en" class="mort-loyalty-english"><p><strong>Save up to 44% on selected products with the ELENA Loyalty Card.</strong> Request yours on WhatsApp to discover our in-store offers. Discounts and conditions vary by product; in-store promotions are subject to applicable terms.</p></div></div><div class="mort-loyalty-action"><a class="button mort-whatsapp" href={loyaltyWhatsapp} target="_blank" rel="noopener noreferrer">Richiedi la tessera su WhatsApp</a></div></div>
  </section>
  <section class="shell section mort-visit"><div><p class="eyebrow">Ci vediamo in bottega</p><h2>Un angolo di gusto a Firenze.</h2><p><strong>{site.address.street}</strong><br />{site.address.postalCode} Firenze · {site.address.note}</p><p lang="en">Find us in Via Masaccio, near Campo di Marte. Ask us to confirm your order, collection time and any dietary requirements before you visit.</p><a class="button" href="https://www.google.com/maps?cid=11883190092574391768" data-map>Apri Google Maps ↗</a><p class="section-link"><a href="/dove-siamo/">Indicazioni e contatti</a> · <a href={site.phoneHref}>Chiama {site.phone}</a></p></div><div><div class="hours-card"><h3>Orari del negozio</h3>{site.hours.map(h => <p class="hours"><span>{h.label}</span><strong>{h.display}</strong></p>)}</div></div></section>
  <section class="shell faq mort-faq"><h2>Prima di ordinare</h2><details><summary>Come funziona il ritiro con WhatsApp?</summary><p>Scegli il prodotto e, per gli affettati, la grammatura. Il pulsante apre un messaggio già compilato. Invia la richiesta: il negozio confermerà disponibilità, prezzo e orario. Il messaggio non conferma automaticamente l’ordine.</p></details><details><summary>La Tartufina contiene crema di tartufo?</summary><p>No. La ricetta prevede vere scaglie di tartufo sott’olio, mortadella Favola Gran Riserva, burrata e rucola. Il prodotto è in arrivo e non è ancora ordinabile.</p></details><details><summary lang="en">Can I collect my order in Florence?</summary><p lang="en">Yes: use the WhatsApp button to request collection. Please wait for the shop to confirm availability, price and collection time. Ask us about ingredients and allergens before ordering.</p></details></section>
  <aside slot="footer-note" class="shell mort-ai-note" aria-labelledby="mort-ai-note-title">
    <h2 id="mort-ai-note-title">Trasparenza delle immagini</h2>
    <p>Alcune immagini presenti sul sito sono state generate con l'ausilio dell'intelligenza artificiale e hanno finalità illustrative. I prodotti effettivamente serviti possono presentare differenze nell'aspetto e nella presentazione.</p>
    <p lang="en">Some images on this website have been created using artificial intelligence for illustrative purposes. Actual products may differ in appearance and presentation.</p>
  </aside>
</BaseLayout>
