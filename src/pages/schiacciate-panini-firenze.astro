---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { mortadellaChannels } from '../data/mortadella';
const schema={'@context':'https://schema.org','@type':'WebPage',name:'Schiacciate e panini a Firenze – Campo di Marte',url:site.url+'/schiacciate-panini-firenze/',mainEntity:{'@type':'FoodEstablishment',name:site.name,url:site.url,hasMenu:site.url+'/menu/'}};
---
<BaseLayout title="Schiacciate e Panini a Firenze – Campo di Marte | ELENA" description="Schiacciate toscane preparate al momento da ELENA, in Via Masaccio a Firenze. Sfoglia il menù fotografico in sette lingue e scegli ritiro o consegna." path="/schiacciate-panini-firenze/" image="/images/menu-digitale/la-sbriciolona.jpg" imageAlt="La Sbriciolona di ELENA" structuredData={schema}>
  <section class="lunch-hero"><div class="shell lunch-hero-grid"><div class="lunch-hero-copy"><p class="eyebrow">Pranzo a Firenze · Campo di Marte</p><h1>Schiacciate e panini a Firenze</h1><p class="lead">Il pane del Forno Coverciano, i salumi e i formaggi scelti al banco. Da ELENA la schiacciata si prepara al momento, in Via Masaccio.</p><a class="button" href="/menu/">Apri il menù fotografico</a><p class="order-note">40 proposte in italiano, inglese, tedesco, francese, spagnolo, cinese semplificato e giapponese.</p></div><figure class="lunch-hero-photo"><img src="/images/menu-digitale/la-sbriciolona.jpg" alt="La Sbriciolona con salume Scarpaccia, pecorino e cipolla caramellata" width="1000" height="750" fetchpriority="high" decoding="async" /></figure></div></section>
  <section class="section shell two-columns"><div><p class="eyebrow">Dalla bottega</p><h2>Un pranzo dal sapore toscano</h2><p>Dalla Sbriciolona Scarpaccia del Casentino al prosciutto cotto Gran Biscotto Rovagnati: ogni ricetta è raccontata nel menù, con fotografie reali e ingredienti. Trovi anche proposte con verdure e la Cecina, verificata VEGAN.</p><p>Per ingredienti, allergeni e richieste particolari chiedi sempre al personale prima di ordinare.</p><a class="text-link" href="/menu/">Scegli la tua schiacciata →</a></div><div><h2>Ritiro e consegna</h2><p>Nel menù puoi personalizzare la richiesta per il ritiro tramite WhatsApp. Attendi la conferma del negozio per disponibilità e orario.</p><div class="hero-actions"><a class="button" href={mortadellaChannels.glovo} target="_blank" rel="noopener noreferrer">Glovo ↗</a><a class="button" href={mortadellaChannels.deliveroo} target="_blank" rel="noopener noreferrer">Deliveroo ↗</a></div><p>Le piattaforme indicano assortimento e copertura della consegna per il tuo indirizzo.</p></div></section>
  <section class="visit section"><div class="shell visit-grid"><div><h2>Ci trovi in Via Masaccio</h2><p>{site.address.street}, {site.address.postalCode} {site.address.city}<br/>{site.address.note}</p><a class="button" href="/dove-siamo/">Indicazioni e contatti</a></div><div class="hours-card"><h3>Orari del negozio</h3>{site.hours.map(h=><p class="hours"><span>{h.label}</span><strong>{h.display}</strong></p>)}</div></div></section>
</BaseLayout>
<style>.lunch-hero{padding:clamp(2.5rem,7vw,6rem) 0;background:var(--cream)}.lunch-hero-grid{display:grid;gap:2rem;align-items:center}.lunch-hero-copy{min-width:0}.lunch-hero h1{font-size:clamp(2.5rem,6vw,4.8rem);overflow-wrap:anywhere}.lunch-hero-photo{margin:0;min-width:0}.lunch-hero-photo img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:contain;border-radius:var(--radius)}.order-note{margin-top:1rem}@media(min-width:900px){.lunch-hero-grid{grid-template-columns:1.1fr 1fr}}</style>
