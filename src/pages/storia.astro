import BaseLayout from '../layouts/BaseLayout.astro'; import Hero from '../components/Hero.astro';
---
<BaseLayout title="La nostra storia | ELENA – Bottega dei Sapori Toscani a Firenze" description="Dalle radici nel Forno Coverciano alla bottega alimentare di Elena in Via Masaccio: una storia familiare fatta di pane e cose buone.">
  <Hero compact eyebrow="La nostra storia" title="Le radici nel pane. Oggi, una bottega di cose buone." text="Una storia semplice, cresciuta nel tempo senza dimenticare da dove è partita." />
  <section class="timeline shell section"><article><span>Circa 10 anni fa</span><h2>Nasce dal Forno Coverciano</h2><p>La Bottega apre come secondo punto vendita del Forno Coverciano, una piccola impresa familiare. Il pane è il primo filo della sua storia.</p></article><article><span>Circa 2 anni fa</span><h2>Arriva Elena</h2><p>Elena rileva l’attività e mantiene forte il rapporto con il Forno Coverciano, iniziando allo stesso tempo a dare alla Bottega un’identità più ampia.</p></article><article><span>Oggi</span><h2>Una bottega che continua a scegliere</h2><p>Al pane si affiancano gastronomia, salumi, formaggi, frutta e verdura e vini. Non per riempire scaffali, ma per proporre prodotti scelti soprattutto per sapore e qualità.</p></article></section>
  <section class="soft section"><div class="shell narrow"><p class="quote">“Una bottega vera è fatta di prodotti, ma anche di persone, consigli e fiducia.”</p><p>È questa la direzione che Elena porta avanti ogni giorno in Via Masaccio, nel quartiere e per il quartiere.</p></div></section>
</BaseLayout>

