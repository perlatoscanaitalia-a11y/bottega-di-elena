---
import BaseLayout from '../layouts/BaseLayout.astro'; import Hero from '../components/Hero.astro'; import ProductList from '../components/ProductList.astro'; import { products } from '../data/site';
import Blu61Card from '../components/Blu61Card.astro';
---
<BaseLayout title="Salumi e formaggi a Firenze | PANIFICIO ELENA – Bottega dei Sapori Toscani" description="Salumi, pecorini, mozzarelle, formaggi e gastronomia selezionati da PANIFICIO ELENA in Via Masaccio a Firenze.">
  <Hero compact eyebrow="Il banco" title="Salumi e formaggi scelti uno per uno." text="Sapori toscani, prodotti di produttori conosciuti e grandi classici. La selezione può cambiare: è il modo più onesto per continuare a cercare qualità." image="/images/banco-elena-ottimizzato.webp" imageWebp="/images/banco-elena-ottimizzato.webp" imageWidth={1201} imageHeight={1309} imageAlt="Banco salumi e formaggi - Panificio ELENA Firenze" />
  <section class="shell" aria-label="Dal banco: Blu ’61"><Blu61Card /></section>
  <div class="section shell product-columns"><ProductList title="Salumi" items={products.salumi} /><ProductList title="Formaggi e latticini" items={products.formaggi} /><ProductList title="Gastronomia" items={products.gastronomia} /></div>
  <section class="note shell"><strong>Mortadella a Firenze</strong><p>Favola Gran Riserva, mortadella al tartufo e schiacciate toscane: <a href="/mortadella-firenze/">scopri la selezione e richiedi il ritiro in negozio</a>.</p><strong>Una nota sulla disponibilità</strong><p>Alcuni prodotti arrivano in giorni precisi, come la Salsiccia Scarpaccia ogni martedì. Per una richiesta specifica, chiamaci prima di passare.</p></section>
</BaseLayout>

