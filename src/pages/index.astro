---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ElenaCta from '../components/ElenaCta.astro';
import SpecialtyCard from '../components/SpecialtyCard.astro';
import { categories, selectedSpecialties, site } from '../data/site';
---
<BaseLayout title="PANIFICIO ELENA – Bottega dei Sapori Toscani | Bottega alimentare a Firenze" description="Pane fresco del Forno Coverciano, gastronomia, salumi, formaggi, frutta e verdura di stagione e vini sfusi in Via Masaccio a Firenze.">
  <Hero eyebrow="Bottega alimentare · Firenze" title="Cose buone, scelte per il loro sapore." text="Pane fresco del Forno Coverciano, gastronomia, salumi e formaggi, frutta e verdura di stagione e vini sfusi. Una bottega vera, in Via Masaccio.">
    <div slot="actions" class="hero-actions"><a class="button" href="/dove-siamo/">Vieni a trovarci</a><a class="text-link" href="/prodotti/">Scopri i prodotti <span aria-hidden="true">→</span></a></div>
  </Hero>
  <section class="intro-band"><div class="shell band-grid"><p class="quote">“La frutta bella si trova facilmente. Quella buona un po’ meno.”</p><p>Seguiamo stagioni e disponibilità. Quando possibile scegliamo verdure locali, spesso direttamente da contadini, senza promettere ciò che la natura non può mantenere.</p></div></section>
  <section class="specialties-preview section shell">
    <div class="section-heading"><div><p class="eyebrow">Specialità al banco</p><h2>Premiati. Scelti da PANIFICIO ELENA.</h2></div><p>Ci sono prodotti buoni. E poi ci sono quelli che si fanno ricordare. Li abbiamo scelti per il gusto, e qualcuno se n’è accorto anche prima di noi.</p></div>
    <div class="specialty-grid">{selectedSpecialties.map((product) => <SpecialtyCard product={product} />)}</div>
    <p class="section-link"><a class="button" href="/specialita-scelte/">Tutte le specialità scelte</a></p>
  </section>
  <section class="section shell"><div class="section-heading"><div><p class="eyebrow">Dentro la Bottega</p><h2>Ogni giorno, una scelta fatta con cura</h2></div><p>Non un catalogo infinito: prodotti selezionati, disponibilità che cambia e persone a cui chiedere un consiglio.</p></div><div class="card-grid">{categories.map((category, i) => <a class={`category-card tone-${i + 1}`} href={category.href}><span class="card-number">0{i + 1}</span><p class="eyebrow">{category.eyebrow}</p><h3>{category.title}</h3><p>{category.text}</p><span class="text-link">Scopri <span aria-hidden="true">→</span></span></a>)}</div></section>
  <section class="good-days section"><div class="shell">
    <div class="section-heading"><div><p class="eyebrow">Gli appuntamenti della settimana</p><h2>I giorni delle cose buone</h2></div><p>Ci sono arrivi che scandiscono la settimana e rendono ogni giorno un po’ diverso.</p></div>
    <div class="weekly-list">
      <article><p class="weekly-day">Lunedì</p><p>Frutta e verdura fresca, anche dal contadino <span aria-hidden="true">•</span> Mozzarella di bufala di Battipaglia</p></article>
      <article><p class="weekly-day">Martedì</p><p>Salsiccia fresca Scarpaccia del Casentino</p></article>
      <article><p class="weekly-day">Mercoledì</p><p>Frutta e verdura fresca, anche dal contadino <span aria-hidden="true">•</span> Mozzarella di bufala di Battipaglia</p></article>
      <article><p class="weekly-day">Venerdì</p><p>Mozzarella di bufala di Battipaglia <span aria-hidden="true">•</span> Uova del Casentino</p></article>
    </div>
    <aside class="daily-dish"><div><p class="eyebrow">Piatto del giorno</p><h3>Ogni volta una proposta diversa</h3></div><p>Il piatto cambia: chiedici cosa abbiamo preparato oggi.</p></aside>
    <p class="availability-note">Gli arrivi possono variare secondo stagione e disponibilità. Se cerchi qualcosa in particolare, <a href={site.phoneHref}>chiamaci prima di passare</a>.</p>
  </div></section>
  <section class="services section shell">
    <div class="section-heading"><div><p class="eyebrow">Servizi di quartiere</p><h2>In bottega c’è anche</h2></div><p>Piccole comodità che trovi insieme alla spesa di ogni giorno.</p></div>
    <div class="service-grid">
      <article><span class="service-number" aria-hidden="true">01</span><h3>Tessera fedeltà</h3><p>Richiedi la tua tessera fedeltà in negozio.</p></article>
      <article><span class="service-number" aria-hidden="true">02</span><h3>Amazon Hub Counter</h3><p>PANIFICIO ELENA è un punto Amazon Hub Counter, dove puoi ritirare i tuoi pacchi Amazon.</p></article>
      <article><span class="service-number" aria-hidden="true">03</span><h3>Too Good To Go</h3><p>PANIFICIO ELENA collabora con Too Good To Go contro lo spreco alimentare.</p></article>
    </div>
  </section>
  <section class="story-split shell"><div class="bread-shape bread-shape-logo"><img src="/images/logo-forno-coverciano.jpg" alt="Logo Il Pane del Forno Coverciano — Il pane come una volta" loading="lazy" decoding="async" /></div><div><p class="eyebrow">Da dove veniamo</p><h2>Le radici nel pane</h2><p>La Bottega nasce circa dieci anni fa come secondo punto vendita del Forno Coverciano. Da circa due anni Elena porta avanti quel legame e allarga la selezione, con la stessa idea semplice: scegliere cose che siano davvero buone.</p><a class="text-link" href="/storia/">Conosci la nostra storia <span aria-hidden="true">→</span></a></div></section>
  <section class="visit section"><div class="shell visit-grid"><div><p class="eyebrow">Passa a trovarci</p><h2>La tua bottega in Via Masaccio</h2><p>{site.address.street}, {site.address.postalCode} Firenze<br /><strong>{site.address.note}</strong></p><a class="button" href={site.phoneHref}>{site.phone}</a></div><div class="hours-card"><h3>Orari da settembre</h3>{site.hours.map((h) => <p class="hours"><span>{h.label}</span><strong>{h.display}</strong></p>)}<a class="text-link" href="/dove-siamo/">Indicazioni e contatti →</a></div></div></section>
  <div class="shell section"><ElenaCta /></div>
</BaseLayout>

